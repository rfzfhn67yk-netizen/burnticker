[Unit]
Description=Burnticker public audit (recompute every receipt; write audit.json; exit 1 on a mismatch) — fired hourly by mct-burnticker-audit.timer
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/meme-coin-trader
ExecStart=/bin/sh %h/meme-coin-trader/scripts/service/run-burnticker-audit.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=TZ=America/Denver
Environment=BURNTICKER_DB=%h/meme-coin-trader/data/burnticker.db
Environment=BURNTICKER_PUBLISH_DIR=%h/meme-coin-trader/data/burnticker-site
# A mismatch exits 1: the unit shows under `systemctl --user list-units --failed`, and the keeper raises bt-audit-mismatch from audit.json.
TimeoutStartSec=600
StandardOutput=append:%h/meme-coin-trader/logs/burnticker-audit.log
StandardError=append:%h/meme-coin-trader/logs/burnticker-audit.log
