[Unit]
Description=Burnticker clone watch (lookalike tokens of DEFICIT / Burnticker / launched tickers → the "Not Burnticker" list) — fired every 15 min by mct-burnticker-clonewatch.timer
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/meme-coin-trader
ExecStart=/bin/sh %h/meme-coin-trader/scripts/service/run-burnticker-clonewatch.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=TZ=America/Denver
Environment=BURNTICKER_DB=%h/meme-coin-trader/data/burnticker.db
TimeoutStartSec=300
StandardOutput=append:%h/meme-coin-trader/logs/burnticker-clonewatch.log
StandardError=append:%h/meme-coin-trader/logs/burnticker-clonewatch.log
