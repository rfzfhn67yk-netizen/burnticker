[Unit]
Description=Burnticker mint key bank (grinds mint keypairs whose address ends in burn or BURN and keeps them sealed for the launch route; sends nothing, holds no funds)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/meme-coin-trader
# Loop mode: refills to BURNTICKER_MINT_BANK_SIZE once fewer than BURNTICKER_MINT_BANK_LOW keys are ready, and checks the bank once a minute.
ExecStart=/bin/sh %h/meme-coin-trader/scripts/service/run-burnticker-mintbank.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=TZ=America/Denver
Environment=BURNTICKER_DB=%h/meme-coin-trader/data/burnticker.db
Environment=BURNTICKER_MINT_BANK_PATH=%h/meme-coin-trader/data/burnticker-mintbank.db
# BURNTICKER_MINT_BANK_KEY (and optionally BURNTICKER_MINT_BANK_SIZE, _LOW, _WORKERS) live in the host's local env file, read by
# run-burnticker-mintbank.sh, never in this file. Without the key the service refuses to start (no plaintext bank, ever).
# The grinder uses every core but one; it runs at a lower priority so the web unit and the keepers always come first.
Nice=10
Restart=always
RestartSec=60
# exit 2 is a refusal (no key, the wrong key, an unsealed file): it is not retried until the owner fixes it and starts the unit again
RestartPreventExitStatus=2
KillSignal=SIGTERM
# a fill in progress finishes its batch and exits within a few seconds
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=append:%h/meme-coin-trader/logs/burnticker-mintbank.log
StandardError=append:%h/meme-coin-trader/logs/burnticker-mintbank.log

[Install]
WantedBy=default.target
