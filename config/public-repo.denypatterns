# the treasury signer's file names: the keepers, the launch and program-admin CLIs and the keygen REFUSE them by name, which is the one place they may appear
/\bsigner(\.enc)?\.json\b/ allow: scripts/burn-keeper.mts scripts/burnticker-keeper.mts scripts/burnkeeper-launch.mts scripts/burnkeeper-keygen.mjs scripts/burnreceipts-admin.mts scripts/paircurve-admin.mts
# the shared signer passphrase variable may appear only where the keeper falls back to it
/AUTONOMOUS_SIGNER_PASSPHRASE/ allow: src/lib/burnKeeper/keyfile.ts scripts/burn-keeper.mts scripts/burnkeeper-launch.mts scripts/burnkeeper-keygen.mjs scripts/service/run-burnkeeper.sh scripts/burnreceipts-admin.mts

# hosts and infrastructure that are not the platform's business
/\b100\.\d{1,3}\.\d{1,3}\.\d{1,3}\b/ allow: test/burntickerOps.test.ts
# (the ops test quotes the public CGNAT range 100.64.0.0/10 that the host firewall allows SSH from; no host address appears)
/\b46\.62\.\d{1,3}\.\d{1,3}\b/
/\btailscale\b/i allow: test/burntickerOps.test.ts docs/burnticker/deploy.md docs/burnticker/REHEARSAL-RUNSHEET.md
# (the product name, in the deploy notes and the test that checks them; never an address)
/\bhetzner\b/i
/mct-mailbox/
