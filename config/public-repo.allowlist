src/lib/launch/dailyPost.ts
src/lib/launch/copyLint.ts
# the GTM post generator (scripts/burnticker-posts.mts, matched by the glob above, imports it; 2026-10-10) and its fixtures/tests
src/lib/launch/postQueue.ts
test/postQueue*.ts
test/gtmDocs.test.ts
config/launch

# --- the two shared modules the public code imports (split out of the private app so nothing else is dragged along) ---
src/lib/sameOrigin.ts
src/lib/live/validateSwap.ts

# --- the refuse list: the operator's trading bots read this and refuse every platform coin. Publishing it is the proof. ---
src/lib/ownTokens.ts
config/own-tokens.json

